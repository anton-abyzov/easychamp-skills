{
  "$comment": "Playoff bracket binary tree node mapping. fixture.order must match nodeId for bracket rendering.",
  "tree_structures": {
    "4_teams": {
      "depth": 2,
      "nodes": {
        "1": { "stage": "final", "depth": 0, "description": "Final" },
