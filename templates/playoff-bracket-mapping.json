        "8": { "stage": "round_of_16", "depth": 3 },
        "9": { "stage": "round_of_16", "depth": 3 },
        "10": { "stage": "round_of_16", "depth": 3 },
        "11": { "stage": "round_of_16", "depth": 3 },
        "12": { "stage": "round_of_16", "depth": 3 },
        "13": { "stage": "round_of_16", "depth": 3 },
        "14": { "stage": "round_of_16", "depth": 3 },
        "15": { "stage": "round_of_16", "depth": 3 }
      }
    }
  },
  "stage_order_mapping": {
    "round_of_128": 6,
    "round_of_64": 5,
    "round_of_32": 4,
    "round_of_16": 3,
    "quarterfinal": 2,
    "semifinal": 1,
    "final": 0,
    "3rd_place_playoff": 0
  },
  "matchDayName_values": {
    "$comment": "These MUST be lowercase, no hyphens. Must match PlayoffStage enum exactly.",
    "valid": ["round_of_128", "round_of_64", "round_of_32", "round_of_16", "quarterfinal", "semifinal", "final", "3rd_place_playoff"],
    "invalid_examples": ["Quarter-Final", "SEMIFINAL", "Semi-Finals", "Round of 16"]
  },
  "notes": [
    "fixture.order MUST match node.nodeId for first-pass tree placement",
    "Empty nodes = byes (top seeds skip rounds)",
    "PUT /fixture/{id}/score does NOT save Order - update MongoDB directly",
    "MongoDB fixtures._id is stored as string, not UUID",
    "Tree depth = Math.ceil(Math.log2(teamsCount))"
  ]
}
