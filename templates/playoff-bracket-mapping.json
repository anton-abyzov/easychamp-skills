        "7": { "stage": "quarterfinal", "depth": 2, "description": "Quarterfinal Right-Right" }
      },
      "diagram": "        1 (Final)\n       / \\\n      2   3 (Semifinal)\n     / \\ / \\\n    4  5 6  7 (Quarterfinal)"
    },
    "16_teams": {
      "depth": 4,
      "nodes": {
